# ===== OKX API 凭证 =====
OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSPHRASE=
# 1 = OKX 模拟盘, 0 = 实盘
OKX_DEMO=1
# 1 = 只模拟不下单(最安全), 0 = 真实下单
DRY_RUN=1

# 可选: 覆盖 config.json
# OKX_INSTID=BTC-USDT-SWAP
# OKX_LEVERAGE=3
# OKX_QTY_PCT=0.8

# ===== 邮件通知 (QQ 邮箱) =====
# 发件邮箱的 SMTP 授权码(不是登录密码! QQ邮箱->设置->账户->开启SMTP获取)
ENABLE_EMAIL_MSG=true
MSG_SMTP_USERNAME=
MSG_SMTP_PASSWORD=
QQ_NOTIFY_TO=
