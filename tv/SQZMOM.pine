//@version=6
strategy("SQZMOM 背离波段", shorttitle="SQZ DIV SW", overlay=true,
     default_qty_type=strategy.percent_of_equity, default_qty_value=80, pyramiding=0,
     max_labels_count=500, max_lines_count=500, max_boxes_count=500)

// --- 配色 ---
const color BULLC = #089981
const color BEARC = #f23645
const color NEUTC = #787b86

// --- 指标 ---
lengthKC = input.int(20, "KC Length", minval=1, group="指标")

// --- 背离 ---
lb     = input.int(2, "枢轴回看", minval=1, group="背离")
useReg = input.bool(true, "常规背离", group="背离")

// --- 出场 ---
atrLen   = input.int(14, "ATR 长度", minval=1, group="出场")
slATR    = input.float(2, "止损 (xATR)", step=0.1, group="出场")
trailATR = input.float(1, "移动止损 (xATR)", step=0.1, group="出场")

// --- 可视化 ---
showDiv   = input.bool(true, "背离标记", group="可视化")
showLines = input.bool(true, "背离连线", group="可视化")
showSLTP  = input.bool(true, "入场/止损线", group="可视化")
showPanel = input.bool(true, "状态面板", group="可视化")

// =============================================================================
// 指标: Squeeze Momentum (动量柱)
// =============================================================================
mom = ta.linreg(close - math.avg(math.avg(ta.highest(high, lengthKC), ta.lowest(low, lengthKC)), ta.sma(close, lengthKC)), lengthKC, 0)

atr = ta.atr(atrLen)

// =============================================================================
// 背离检测 (价格枢轴 vs 动量柱)
// =============================================================================
pl = low[lb]  == ta.lowest(low, 2 * lb + 1)
ph = high[lb] == ta.highest(high, 2 * lb + 1)

var float plMom1 = na
var float plMom2 = na
var float plPx1  = na
var float plPx2  = na
var int   plX1   = na
var int   plX2   = na

var float phMom1 = na
var float phMom2 = na
var float phPx1  = na
var float phPx2  = na
var int   phX1   = na
var int   phX2   = na

if pl
    plMom2 := plMom1
    plPx2  := plPx1
    plX2   := plX1
    plMom1 := mom[lb]
    plPx1  := low[lb]
    plX1   := bar_index - lb

if ph
    phMom2 := phMom1
    phPx2  := phPx1
    phX2   := phX1
    phMom1 := mom[lb]
    phPx1  := high[lb]
    phX1   := bar_index - lb

bullDiv = useReg and pl and not na(plMom2) and plPx1 < plPx2 and plMom1 > plMom2
bearDiv = useReg and ph and not na(phMom2) and phPx1 > phPx2 and phMom1 < phMom2

// =============================================================================
// 交易状态
// =============================================================================
var float entryPx = na
var float atrRef  = na

flat = strategy.position_size == 0

// --- 入场: 背离确认后市价入场 ---
if bullDiv and flat
    strategy.entry("L", strategy.long, comment="L")

if bearDiv and flat
    strategy.entry("S", strategy.short, comment="S")

// --- 出场: 移动止损 ---
if strategy.position_size != 0 and na(entryPx)
    entryPx := strategy.position_avg_price
    atrRef  := nz(atr, entryPx * 0.005)

if strategy.position_size == 0 and not na(entryPx)
    entryPx := na
    atrRef  := na

trailTicks = trailATR * atrRef / syminfo.mintick

if strategy.position_size > 0 and not na(entryPx)
    strategy.exit("xL", from_entry="L", stop=entryPx - slATR * atrRef, trail_points=trailTicks, trail_offset=trailTicks, comment="Trail")
else if strategy.position_size < 0 and not na(entryPx)
    strategy.exit("xS", from_entry="S", stop=entryPx + slATR * atrRef, trail_points=trailTicks, trail_offset=trailTicks, comment="Trail")

// =============================================================================
// 绘图层
// =============================================================================
// 背离连线 (画在价格枢轴上)
if showLines and bullDiv
    line.new(plX2, plPx2, plX1, plPx1, xloc.bar_index, color=BULLC, style=line.style_solid, width=2)
if showLines and bearDiv
    line.new(phX2, phPx2, phX1, phPx1, xloc.bar_index, color=BEARC, style=line.style_solid, width=2)

plotshape(showDiv and bullDiv, title="看涨背离", style=shape.labelup, location=location.belowbar, color=color.new(BULLC, 0), textcolor=color.white, text="Bull", size=size.tiny, offset=-lb)
plotshape(showDiv and bearDiv, title="看跌背离", style=shape.labeldown, location=location.abovebar, color=color.new(BEARC, 0), textcolor=color.white, text="Bear", size=size.tiny, offset=-lb)

// 入场线 / 止损线
slLvl = strategy.position_size > 0 ? entryPx - slATR * atrRef : strategy.position_size < 0 ? entryPx + slATR * atrRef : na
plot(showSLTP ? entryPx : na, "入场价", color=color.new(NEUTC, 0), style=plot.style_linebr, linewidth=1)
plot(showSLTP ? slLvl : na, "止损", color=color.new(BEARC, 0), style=plot.style_linebr, linewidth=1)

// 数据窗口
plot(mom, "动量", display=display.data_window)
plot(atr, "ATR", display=display.data_window)

// 状态面板
var table tb = table.new(position.top_right, 2, 6, border_width=1, frame_color=color.new(NEUTC, 30), border_color=color.new(NEUTC, 70))
if showPanel and barstate.islast
    nTr = strategy.closedtrades
    nWin = strategy.wintrades
    pf = strategy.grossloss > 0 ? strategy.grossprofit / strategy.grossloss : na
    hdr = color.new(#2a2e39, 0)
    rA  = color.new(NEUTC, 88)
    rB  = color.new(NEUTC, 82)
    posTxt = strategy.position_size > 0 ? "做多" : strategy.position_size < 0 ? "做空" : "—"
    posCss = strategy.position_size > 0 ? BULLC : strategy.position_size < 0 ? BEARC : NEUTC
    table.cell(tb, 0, 0, "SQZMOM 背离", text_color=color.white, bgcolor=hdr, text_size=size.small)
    table.cell(tb, 1, 0, "波段", text_color=color.new(#2962ff, 0), bgcolor=hdr, text_size=size.small)
    table.cell(tb, 0, 1, "状态", text_color=NEUTC, bgcolor=rA, text_size=size.small)
    table.cell(tb, 1, 1, posTxt, text_color=posCss, bgcolor=rA, text_size=size.small)
    table.cell(tb, 0, 2, "入场/止损", text_color=NEUTC, bgcolor=rB, text_size=size.small)
    table.cell(tb, 1, 2, not na(entryPx) ? str.tostring(entryPx, format.mintick) + " / " + str.tostring(slLvl, format.mintick) : "—", text_color=color.white, bgcolor=rB, text_size=size.small)
    table.cell(tb, 0, 3, "笔数 / 胜率", text_color=NEUTC, bgcolor=rA, text_size=size.small)
    table.cell(tb, 1, 3, str.tostring(nTr) + " / " + (nTr > 0 ? str.tostring(nWin / nTr * 100, "#.0") + "%" : "—"), text_color=color.white, bgcolor=rA, text_size=size.small)
    table.cell(tb, 0, 4, "盈利因子 PF", text_color=NEUTC, bgcolor=rB, text_size=size.small)
    table.cell(tb, 1, 4, na(pf) ? "—" : str.tostring(pf, "#.00"), text_color=color.white, bgcolor=rB, text_size=size.small)
    table.cell(tb, 0, 5, "净利", text_color=NEUTC, bgcolor=rA, text_size=size.small)
    table.cell(tb, 1, 5, str.tostring(strategy.netprofit, "#.##"), text_color=strategy.netprofit >= 0 ? BULLC : BEARC, bgcolor=rA, text_size=size.small)
